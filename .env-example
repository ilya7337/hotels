# Application
MODE=DEV
LOG_LEVEL=INFO

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=booking_app

# JWT Auth
SECRET_JWT_KEY=changeme
ALGORITHM_JWT=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis
# Пример локального URL: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# SMTP (почтовые уведомления)
SMPT_HOST=smtp.gmail.com
SMPT_PORT=465
SMPT_USER=your_email@gmail.com
SMTP_PASS=app_password

# Дополнительно (если используется Docker Compose)
POSTGRES_DB=booking_app
POSRGRES_USER=postgres
POSRGRES_PASSWORD=postgres

